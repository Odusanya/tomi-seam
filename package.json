{
  "name": "tomi-design-engineer",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && npm run lint:deprecated",
    "lint:deprecated": "oxlint --type-aware -A all -D typescript/no-deprecated --ignore-pattern \"components/ui/**\" app components lib hooks",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,md}\"",
    "check": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/colors": "^3.0.0",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.24.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "^1.94.0",
    "oxlint-tailwindcss": "^1.17.2",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
